# Copy to .env.local (per app) or .env at the repo root and fill in real values.
# Nothing in this scaffold connects to a live service yet — see
# packages/database/src/client.ts for where these get wired up.

# Neon Postgres connection strings, provisioned via the Neon integration in
# Vercel. Server-side only — never expose these to the browser.

# Pooled connection (PgBouncer). Used by the app at runtime.
DATABASE_URL=postgres://user:password@ep-example-000000-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct/unpooled connection. Used for schema migrations (drizzle-kit) —
# running DDL through the pooler is a known source of intermittent failures.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example-000000.region.aws.neon.tech/neondb?sslmode=require

# Auth.js (apps/portal). AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET come from a
# Google Cloud Console OAuth client; AUTH_SECRET is a generated secret
# (`npx auth secret`, or any random 32+ byte value).
AUTH_SECRET=replace-with-a-generated-secret
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Auth.js (apps/admin). Deliberately distinct var names from the portal's
# above — admin needs its own AUTH_ADMIN_SECRET so session tokens aren't
# forgeable across the two apps, even if the Google OAuth client and its
# id/secret happen to be shared. Same sourcing as the portal block.
AUTH_ADMIN_SECRET=replace-with-a-generated-secret
AUTH_ADMIN_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_ADMIN_GOOGLE_SECRET=your-google-client-secret

# Comma-separated list of exact email addresses allowed to sign in to
# apps/admin. Case-insensitive. Add teammates here as you onboard them.
AUTH_ADMIN_ALLOWED_EMAILS=you@example.com,teammate@example.com
