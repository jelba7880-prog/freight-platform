# Copy to .env.local (per app) or .env at the repo root and fill in real values.
# Nothing in this scaffold connects to a live service yet — see
# packages/database/src/client.ts for where these get wired up.

# Supabase project URL. Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public API key. Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
